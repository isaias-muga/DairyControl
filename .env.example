# Copy to .env and replace every placeholder. .env is git-ignored; never commit it.

# SQL Server 'sa' password.
# Rules: at least 8 characters and at least 3 of: uppercase, lowercase, digits, symbols.
# It is embedded in a connection string, so avoid ; ' " and leading/trailing spaces.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Pass

# JWT signing key: random string, at least 32 characters.
JWT_SIGNING_KEY=replace-with-a-random-string-of-32-or-more-chars

# Password for the 'admin' user (username is in appsettings.json).
ADMIN_PASSWORD=replace-with-an-admin-password
