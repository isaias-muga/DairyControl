<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <!-- Microsoft.Data.SqlClient brings 9.0.11, which has known DoS advisories (CVE-2026-84008, CVE-2026-70162); 10.0.13 is the first patched version. Remove when SqlClient depends on a patched one. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- The applied migrations and the snapshot refer to AppDbContext without a using (it used to be in the global namespace); they must not be edited -->
    <Using Include="DairyControl.Infrastructure.Persistence" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DairyControl.Application\DairyControl.Application.csproj" />
    <ProjectReference Include="..\DairyControl.Domain\DairyControl.Domain.csproj" />
  </ItemGroup>

</Project>
